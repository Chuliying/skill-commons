# Public release boundary. A fresh-history export may use `git archive`; keep
# private/repository-development history out while retaining public user docs.
/_archive/** export-ignore
/docs/ai-harness-engineering-anthropic.md export-ignore
/docs/anthropic-skill-system.md export-ignore
/docs/superpowers/** export-ignore
/docs/work-summary.html export-ignore
/docs/work/** export-ignore
/docs/skills-reorg/** export-ignore
/docs/skills-reorg/decisions.md -export-ignore
/docs/STATUS.md export-ignore
/docs/shared-skill-onboarding-checklist.md export-ignore
/docs/skill-eval-sop.md export-ignore
/website/** export-ignore
**/.env export-ignore
**/.env.* export-ignore
**/.env.example -export-ignore

# Benchmark result payloads are immutable verbatim host/model evidence. Preserve
# Markdown hard-break spaces and other source formatting without normalizing it.
/docs/work/skill-bundle-effect-benchmark/benchmark/results/** -whitespace

# Maintainer-only test suites. They read private inventories that a public
# payload does not contain, so the payload must not carry them: tests/verify.sh
# discovers suites from the tree, and this is the single place the public/private
# test boundary is declared.
/tests/test_skill_inventory.sh export-ignore
/tests/test_skill_surface.sh export-ignore
/tests/test_skill_bundle_benchmark.sh export-ignore

# Maintainer-only test: it reads the QA corpus roster from docs/work/**, which is
# itself export-ignore, so a public payload cannot satisfy it. Keeping it in the
# payload turned the private-doc dependency into a fail-closed ERROR there.
/tests/py/integration/test_corpus_completeness.py export-ignore
